# Copy to .env (gitignored). Read only by scripts/relay.mjs, never by the browser.
ANTHROPIC_API_KEY=
# Optional:
# RELAY_MODEL=claude-haiku-5-5
# RELAY_PORT=8787
# RELAY_ORIGIN=http://localhost:5173
# Local models through Ollama (Mixed minds, #97); no key needed:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
# RELAY_LOCAL_TIMEOUT=8000
# RELAY_LOCAL_WRITE_TIMEOUT=30000
# OpenAI (ChatGPT models), Mixed minds #97. Billed per token on the API (separate from ChatGPT Plus).
# Create a key at https://platform.openai.com/api-keys, then restart the relay:
OPENAI_API_KEY=
# Optional: a default model id (none in code; pick one in the game or with --model), a compatible server,
# and how many OpenAI calls the relay makes at once:
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# RELAY_OPENAI_CONCURRENCY=4
# Hugging Face router (#552), the free allowance only (never pass paid options). Token: https://huggingface.co/settings/tokens
# HF_TOKEN=
# Optional: a default model id (org/name), another base URL, and relay concurrency:
# HF_MODEL=
# HF_BASE_URL=https://router.huggingface.co/v1
# RELAY_HF_CONCURRENCY=2
# Not built yet (stub):
# GOOGLE_API_KEY=
