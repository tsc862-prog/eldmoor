# Copy to .env (gitignored). Read only by scripts/relay.mjs, never by the browser.
ANTHROPIC_API_KEY=
# Optional:
# RELAY_MODEL=claude-haiku-5-5
# RELAY_PORT=8787
# RELAY_ORIGIN=http://localhost:5173
# Local models through Ollama (Mixed minds, #97); no key needed:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
# RELAY_LOCAL_TIMEOUT=8000
# RELAY_LOCAL_WRITE_TIMEOUT=30000
# OpenAI (ChatGPT models), Mixed minds #97. Billed per token on the API (separate from ChatGPT Plus).
# Create a key at https://platform.openai.com/api-keys, then restart the relay:
OPENAI_API_KEY=
# Optional: a default model id (none in code; pick one in the game or with --model), a compatible server,
# and how many OpenAI calls the relay makes at once:
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# RELAY_OPENAI_CONCURRENCY=4
# Hugging Face router (#552), mind provider `huggingface`. Recharge is off: the free allowance, shared with the art pipeline.
# Token: https://huggingface.co/settings/tokens
# HF_TOKEN=
# Optional: a default model id (org/name), the picker list (comma separated, replaces the built-in four), another base URL, relay concurrency:
# HF_MODEL=
# HF_MODELS=meta-llama/Llama-3.1-8B-Instruct,meta-llama/Llama-3.3-70B-Instruct
# HF_BASE_URL=https://router.huggingface.co/v1
# RELAY_HF_CONCURRENCY=4
# Not built yet (stub):
# GOOGLE_API_KEY=
# Claude session size (issue #787). Haiku 5.5 costs 5x once a prompt passes 100k tokens, so sessions roll between turns.
# SESSION_ROLL_TOKENS=80000
# SESSION_RECAP=0 (no recap of the last talk in a fresh session, #808)
# DM_ROLL_TOKENS=150000
# The net above the roll (the CLI compacts 33k below this); by default the roll point + 40000.
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=120000
# Game minutes before a companion's line may start a listener's turn again (default 15): raise it to slow a chatty company.
# AGENT_HEAR_WAKE_MIN=15
# Lazy tools (#808): hero and company Claude runners keep the common tools in the prompt and find the rest with ToolSearch. Off unless 1; the DM is never lazy.
# AGENT_LAZY_TOOLS=1
